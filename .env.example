# "mac" ou "pi" — change le comportement de certains modules (paths, etc.)
ENV=mac

# IP de cette machine, telle que vue par l'ESP32 et le Nano RP2040
# Mac en dev  → 192.168.1.XX (votre IP locale) ou localhost pour tester sans firmware
# Pi en prod  → 192.168.1.YY (IP fixe du Pi sur votre réseau)
HOST_IP=localhost

# Port du serveur FastAPI
PORT=8000

# Broker MQTT
# Mac : "localhost" si Mosquitto tourne sur le Mac
# Pi  : "localhost" aussi
MQTT_BROKER=localhost
MQTT_PORT=1883

# Timezone
TZ=Europe/Zurich
